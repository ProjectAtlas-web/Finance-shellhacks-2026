  <script>
(function (root) {
  "use strict";

  const PAYMENTS_PER_YEAR = 2;
  const MILLISECONDS_PER_DAY = 86400000;
  const DAYS_PER_YEAR = 365.2425;
  const BOND_TYPES = ["bullet", "callable", "putable"];

  function finiteNumber(value) {
    if (value === "" || value === null || value === undefined) return NaN;
    const number = Number(value);
    return Number.isFinite(number) ? number : NaN;
  }

  function parseCalendarDate(value) {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || ""));
    if (!match) return null;
    const year = Number(match[1]);
    const month = Number(match[2]);
    const day = Number(match[3]);
    const timestamp = Date.UTC(year, month - 1, day);
    const date = new Date(timestamp);
    if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;
    return timestamp;
  }

  function localTodayTimestamp() {
    const now = new Date();
    return Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
  }

  function maturityFromDate(maturityDate, asOfDate) {
    const maturityTimestamp = parseCalendarDate(maturityDate);
    const asOfTimestamp = asOfDate ? parseCalendarDate(asOfDate) : localTodayTimestamp();
    if (maturityTimestamp === null || asOfTimestamp === null) return null;
    const days = Math.round((maturityTimestamp - asOfTimestamp) / MILLISECONDS_PER_DAY);
    return { days, years: days / DAYS_PER_YEAR };
  }

  function validateBond(bond) {
    const errors = {};
    const amount = finiteNumber(bond.amount);
    const price = finiteNumber(bond.price);
    const coupon = finiteNumber(bond.coupon);
    const bondType = bond.type || "bullet";
    const maturityDate = String(bond.maturityDate || "").trim();
    const maturity = maturityDate ? maturityFromDate(maturityDate) : null;
    const years = maturity ? maturity.years : finiteNumber(bond.years);

    if (!bond.name || !String(bond.name).trim()) errors.name = "Enter a bond name.";
    if (!(amount > 0)) errors.amount = "Enter an investment amount greater than zero.";
    if (!(price > 0)) errors.price = "Enter a current price greater than zero.";
    if (!(coupon >= 0)) errors.coupon = "Enter a coupon rate of zero or more.";
    if (!BOND_TYPES.includes(bondType)) errors.type = "Choose Bullet, Callable, or Putable.";
    if (maturityDate && maturity === null) errors.maturityDate = "Enter a valid maturity date.";
    else if (maturityDate && !(maturity.days > 0)) errors.maturityDate = "Choose a maturity date after today.";
    else if (!(years > 0)) errors.years = "Enter years to maturity greater than zero.";

    return { valid: Object.keys(errors).length === 0, errors, values: { amount, price, coupon, years, bondType, maturityDate, daysRemaining: maturity ? maturity.days : null } };
  }

  function cashFlows(couponPercent, years) {
    const periods = Math.max(1, Math.round(years * PAYMENTS_PER_YEAR));
    const couponPayment = couponPercent / PAYMENTS_PER_YEAR;
    const flows = [];
    for (let period = 1; period <= periods; period += 1) {
      flows.push(couponPayment + (period === periods ? 100 : 0));
    }
    return flows;
  }

  function presentValue(flows, periodRate) {
    return flows.reduce((sum, cashFlow, index) => {
      return sum + cashFlow / Math.pow(1 + periodRate, index + 1);
    }, 0);
  }

  function yieldToMaturity(price, couponPercent, years) {
    const flows = cashFlows(couponPercent, years);
    let low = -0.999999;
    let high = 10;

    for (let iteration = 0; iteration < 180; iteration += 1) {
      const mid = (low + high) / 2;
      const value = presentValue(flows, mid);
      if (value > price) low = mid;
      else high = mid;
    }

    const periodRate = (low + high) / 2;
    const annualYield = periodRate * PAYMENTS_PER_YEAR;
    return Number.isFinite(annualYield) ? annualYield : 0;
  }

  function durationAndConvexity(price, couponPercent, years, annualYield) {
    const flows = cashFlows(couponPercent, years);
    const periodRate = annualYield / PAYMENTS_PER_YEAR;
    let weightedTime = 0;
    let convexitySum = 0;

    flows.forEach((cashFlow, index) => {
      const period = index + 1;
      const discounted = cashFlow / Math.pow(1 + periodRate, period);
      weightedTime += period * discounted;
      convexitySum += cashFlow * period * (period + 1) / Math.pow(1 + periodRate, period + 2);
    });

    const macaulayYears = weightedTime / price / PAYMENTS_PER_YEAR;
    const modifiedDuration = macaulayYears / (1 + periodRate);
    const convexity = convexitySum / price / Math.pow(PAYMENTS_PER_YEAR, 2);
    return {
      modifiedDuration: Number.isFinite(modifiedDuration) ? modifiedDuration : 0,
      convexity: Number.isFinite(convexity) ? convexity : 0
    };
  }

  function calculateBond(bond, rateChange) {
    const check = validateBond(bond);
    if (!check.valid) return { valid: false, errors: check.errors };

    const parsedRateChange = finiteNumber(rateChange);
    const shock = Number.isFinite(parsedRateChange) ? parsedRateChange : 0;
    const { amount, price, coupon, years, bondType, maturityDate, daysRemaining } = check.values;
    const currentValue = amount * price / 100;
    const ytm = yieldToMaturity(price, coupon, years);
    const risk = durationAndConvexity(price, coupon, years, ytm);
    const estimatedChange = -risk.modifiedDuration * shock + 0.5 * risk.convexity * shock * shock;
    const changePercent = Math.max(-1, estimatedChange);
    const dollarChange = currentValue * changePercent;
    const lossPercent = Math.max(0, -changePercent);
    const gainPercent = Math.max(0, changePercent);
    const loss = Math.max(0, -dollarChange);
    const gain = Math.max(0, dollarChange);
    const afterValue = Math.max(0, currentValue + dollarChange);

    const numbers = [currentValue, ytm, risk.modifiedDuration, risk.convexity, changePercent, dollarChange, lossPercent, gainPercent, loss, gain, afterValue];
    if (!numbers.every(Number.isFinite)) return { valid: false, errors: { calculation: "This bond could not be calculated. Check its values." } };

    return {
      valid: true,
      name: String(bond.name).trim(),
      type: bondType,
      maturityDate,
      years,
      daysRemaining,
      currentValue,
      ytm,
      modifiedDuration: risk.modifiedDuration,
      convexity: risk.convexity,
      changePercent,
      dollarChange,
      lossPercent,
      gainPercent,
      loss,
      gain,
      afterValue
    };
  }

  function calculatePortfolio(bonds, rateChange) {
    const results = bonds.map((bond) => calculateBond(bond, rateChange));
    const validResults = results.filter((result) => result.valid);
    const totals = validResults.reduce((sum, result) => {
      sum.currentValue += result.currentValue;
      sum.dollarChange += result.dollarChange;
      sum.loss += result.loss;
      sum.gain += result.gain;
      sum.afterValue += result.afterValue;
      return sum;
    }, { currentValue: 0, dollarChange: 0, loss: 0, gain: 0, afterValue: 0 });
    totals.changePercent = totals.currentValue > 0 ? totals.dollarChange / totals.currentValue : 0;
    totals.lossPercent = totals.currentValue > 0 ? totals.loss / totals.currentValue : 0;
    totals.gainPercent = totals.currentValue > 0 ? totals.gain / totals.currentValue : 0;
    return { results, validResults, totals };
  }

  root.BondMath = { maturityFromDate, validateBond, yieldToMaturity, durationAndConvexity, calculateBond, calculatePortfolio };
})(typeof globalThis !== "undefined" ? globalThis : window);

</script>
  <script>
(function () {
  "use strict";

  const examples = [
    { name: "5-year U.S. Treasury note", type: "bullet", amount: 25000, price: 98.5, coupon: 3.5, years: 5 },
    { name: "10-year investment-grade bond", type: "callable", amount: 25000, price: 101.25, coupon: 4.75, years: 10 }
  ];

  const bondList = document.getElementById("bond-list");
  const template = document.getElementById("bond-template");
  const addButton = document.getElementById("add-bond");
  const resultsBody = document.getElementById("results-body");
  const status = document.getElementById("calculation-status");
  const totalCurrent = document.getElementById("total-current");
  const totalLoss = document.getElementById("total-loss");
  const totalLossPercent = document.getElementById("total-loss-percent");
  const totalAfter = document.getElementById("total-after");
  const resultTitle = document.getElementById("step-3-title");
  const resultHelpLabel = document.getElementById("result-help-label");
  const resultHelpText = document.getElementById("result-help-text");
  const dollarChangeLabel = document.getElementById("dollar-change-label");
  const percentChangeLabel = document.getElementById("percent-change-label");
  const afterChangeLabel = document.getElementById("after-change-label");
  const resultTableCaption = document.getElementById("result-table-caption");
  const bondDollarChangeLabel = document.getElementById("bond-dollar-change-label");
  const bondPercentChangeLabel = document.getElementById("bond-percent-change-label");
  const bondAfterChangeLabel = document.getElementById("bond-after-change-label");
  const optionNotice = document.getElementById("option-notice");
  let nextBondId = 1;

  const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const percent = new Intl.NumberFormat("en-US", { style: "percent", minimumFractionDigits: 2, maximumFractionDigits: 2 });

  function setInputValue(card, selector, value) {
    card.querySelector(selector).value = value;
  }

  function assignField(card, selector, labelText, id) {
    const input = card.querySelector(selector);
    const field = input.closest(".field");
    const label = field.querySelector("label");
    const error = field.querySelector(".field-error");
    input.id = id;
    label.htmlFor = id;
    error.id = id + "-error";
    input.setAttribute("aria-describedby", id + "-help " + error.id);
    field.querySelector(".help-text").id = id + "-help";
    input.dataset.label = labelText;
  }

  function syncMaturityFromDate(card) {
    const dateInput = card.querySelector(".bond-maturity-date");
    const yearsInput = card.querySelector(".bond-years");
    const yearsLabel = card.querySelector(".years-label");
    const yearsHelp = card.querySelector(".years-help");
    if (!dateInput.value) {
      yearsInput.readOnly = false;
      yearsLabel.textContent = "Years until maturity";
      yearsHelp.innerHTML = "<strong>Maturity:</strong> Enter decimal years, or choose a maturity date above.";
      return;
    }
    const maturity = BondMath.maturityFromDate(dateInput.value);
    yearsInput.readOnly = true;
    yearsLabel.textContent = "Years until maturity (calculated)";
    if (maturity && maturity.days > 0) {
      yearsInput.value = maturity.years.toFixed(3);
      yearsHelp.innerHTML = "<strong>Calculated:</strong> " + maturity.days.toLocaleString("en-US") + " days, or " + maturity.years.toFixed(3) + " years.";
    } else {
      yearsInput.value = "";
      yearsHelp.innerHTML = "<strong>Calculated:</strong> Choose a future maturity date.";
    }
  }

  function addBond(values, focusName) {
    const fragment = template.content.cloneNode(true);
    const card = fragment.querySelector(".bond-card");
    const bondId = nextBondId++;
    card.dataset.bondId = String(bondId);

    assignField(card, ".bond-name", "Bond name", "bond-" + bondId + "-name");
    assignField(card, ".bond-type", "Bond structure", "bond-" + bondId + "-type");
    assignField(card, ".bond-amount", "Amount invested", "bond-" + bondId + "-amount");
    assignField(card, ".bond-price", "Current price per $100", "bond-" + bondId + "-price");
    assignField(card, ".bond-coupon", "Annual coupon rate", "bond-" + bondId + "-coupon");
    assignField(card, ".bond-maturity-date", "Maturity date", "bond-" + bondId + "-maturity-date");
    assignField(card, ".bond-years", "Years until maturity", "bond-" + bondId + "-years");

    setInputValue(card, ".bond-name", values.name || "");
    setInputValue(card, ".bond-type", values.type || "bullet");
    setInputValue(card, ".bond-amount", values.amount ?? "");
    setInputValue(card, ".bond-price", values.price ?? "");
    setInputValue(card, ".bond-coupon", values.coupon ?? "");
    setInputValue(card, ".bond-maturity-date", values.maturityDate || "");
    setInputValue(card, ".bond-years", values.years ?? "");
    syncMaturityFromDate(card);

    card.querySelector(".bond-maturity-date").addEventListener("input", () => syncMaturityFromDate(card));

    card.querySelector(".remove-bond").addEventListener("click", () => {
      const cards = bondList.querySelectorAll(".bond-card");
      const fallback = card.previousElementSibling || card.nextElementSibling || addButton;
      card.remove();
      updatePositions();
      updateResults();
      if (fallback && typeof fallback.focus === "function") fallback.focus();
      if (cards.length === 1) status.textContent = "No bonds remain. Add a bond to calculate an estimate.";
    });

    card.addEventListener("input", updateResults);
    bondList.appendChild(fragment);
    updatePositions();
    updateResults();
    if (focusName) card.querySelector(".bond-name").focus();
  }

  function updatePositions() {
    bondList.querySelectorAll(".bond-card").forEach((card, index) => {
      card.querySelector(".bond-position").textContent = String(index + 1);
      const name = card.querySelector(".bond-name").value.trim();
      card.querySelector(".remove-bond").setAttribute("aria-label", "Remove " + (name || "bond " + (index + 1)));
    });
  }

  function readBonds() {
    return Array.from(bondList.querySelectorAll(".bond-card")).map((card) => ({
      card,
      name: card.querySelector(".bond-name").value,
      type: card.querySelector(".bond-type").value,
      amount: card.querySelector(".bond-amount").value,
      price: card.querySelector(".bond-price").value,
      coupon: card.querySelector(".bond-coupon").value,
      maturityDate: card.querySelector(".bond-maturity-date").value,
      years: card.querySelector(".bond-years").value
    }));
  }

  function selectedShock() {
    const checked = document.querySelector('input[name="rate-shock"]:checked');
    const direction = document.querySelector('input[name="rate-direction"]:checked');
    return (checked ? Number(checked.value) : 0.01) * (direction ? Number(direction.value) : 1);
  }

  function showErrors(item, result) {
    const map = { name: ".bond-name", type: ".bond-type", amount: ".bond-amount", price: ".bond-price", coupon: ".bond-coupon", maturityDate: ".bond-maturity-date", years: ".bond-years" };
    Object.entries(map).forEach(([key, selector]) => {
      const input = item.card.querySelector(selector);
      const field = input.closest(".field");
      const error = field.querySelector(".field-error");
      const message = result.errors && result.errors[key] ? result.errors[key] : "";
      error.textContent = message;
      field.classList.toggle("invalid", Boolean(message));
      input.setAttribute("aria-invalid", message ? "true" : "false");
    });
  }

  function resultRow(result, isGain) {
    const row = document.createElement("tr");
    const word = isGain ? "Gain" : "Loss";
    const sign = isGain ? "+" : "−";
    const amount = isGain ? result.gain : result.loss;
    const rate = isGain ? result.gainPercent : result.lossPercent;
    const typeLabels = { bullet: "Bullet bond", callable: "Callable bond — maturity-based estimate", putable: "Putable bond — maturity-based estimate" };
    const nameCell = document.createElement("td");
    nameCell.dataset.label = "Bond name";
    nameCell.className = "bond-name-cell";
    nameCell.setAttribute("aria-label", "Bond name: " + result.name + ", " + (typeLabels[result.type] || "Bullet bond"));
    const nameStrong = document.createElement("strong");
    nameStrong.textContent = result.name;
    const typeTag = document.createElement("span");
    typeTag.className = "structure-tag";
    typeTag.textContent = typeLabels[result.type] || "Bullet bond";
    nameCell.append(nameStrong, typeTag);
    row.appendChild(nameCell);
    const values = [
      ["Current value", currency.format(result.currentValue), ""],
      ["Estimated dollar " + word.toLowerCase(), word + " " + sign + currency.format(amount), isGain ? "gain-text" : "loss-text"],
      ["Estimated percentage " + word.toLowerCase(), word + " " + sign + percent.format(rate), isGain ? "gain-text" : "loss-text"],
      ["Value after rate change", currency.format(result.afterValue), ""]
    ];
    values.forEach(([label, value, className]) => {
      const cell = document.createElement("td");
      cell.dataset.label = label;
      cell.textContent = value;
      cell.setAttribute("aria-label", label + ": " + value);
      if (className) cell.className = className;
      row.appendChild(cell);
    });
    return row;
  }

  function updateResults() {
    updatePositions();
    const items = readBonds();
    const shock = selectedShock();
    const isGain = shock < 0;
    const portfolio = BondMath.calculatePortfolio(items, shock);
    resultsBody.replaceChildren();

    resultTitle.textContent = isGain ? "View the estimated gain" : "View the estimated loss";
    resultHelpLabel.textContent = isGain ? "Estimated gain:" : "Estimated loss:";
    resultHelpText.textContent = isGain ? "The approximate increase in market value if rates fall." : "The approximate decline in market value if rates rise.";
    dollarChangeLabel.textContent = isGain ? "Estimated dollar gain" : "Estimated dollar loss";
    percentChangeLabel.textContent = isGain ? "Estimated percentage gain" : "Estimated percentage loss";
    afterChangeLabel.textContent = isGain ? "Estimated value after rate decrease" : "Estimated value after rate increase";
    resultTableCaption.textContent = isGain ? "Estimated gain for each valid bond" : "Estimated loss for each valid bond";
    bondDollarChangeLabel.textContent = isGain ? "Estimated dollar gain" : "Estimated dollar loss";
    bondPercentChangeLabel.textContent = isGain ? "Estimated percentage gain" : "Estimated percentage loss";
    bondAfterChangeLabel.textContent = isGain ? "Value after rate decrease" : "Value after rate increase";
    document.querySelectorAll(".change-card").forEach((card) => {
      card.classList.toggle("gain-card", isGain);
      card.classList.toggle("loss-card", !isGain);
    });

    portfolio.results.forEach((result, index) => showErrors(items[index], result));
    portfolio.validResults.forEach((result) => resultsBody.appendChild(resultRow(result, isGain)));
    optionNotice.hidden = !portfolio.validResults.some((result) => result.type === "callable" || result.type === "putable");

    if (!portfolio.validResults.length) {
      const row = document.createElement("tr");
      row.className = "empty-row";
      const cell = document.createElement("td");
      cell.colSpan = 5;
      cell.textContent = "Enter at least one valid bond to see an estimate.";
      row.appendChild(cell);
      resultsBody.appendChild(row);
    }

    totalCurrent.textContent = currency.format(portfolio.totals.currentValue);
    totalLoss.textContent = isGain ? "Gain +" + currency.format(portfolio.totals.gain) : "Loss −" + currency.format(portfolio.totals.loss);
    totalLossPercent.textContent = isGain ? "Gain +" + percent.format(portfolio.totals.gainPercent) : "Loss −" + percent.format(portfolio.totals.lossPercent);
    totalAfter.textContent = currency.format(portfolio.totals.afterValue);

    const invalidCount = portfolio.results.length - portfolio.validResults.length;
    if (!items.length) status.textContent = "No bonds remain. Add a bond to calculate an estimate.";
    else if (invalidCount) status.textContent = invalidCount + (invalidCount === 1 ? " bond needs" : " bonds need") + " correction and is not included in the totals.";
    else status.textContent = "";
  }

  addButton.addEventListener("click", () => addBond({ name: "", type: "bullet", amount: "", price: 100, coupon: "", maturityDate: "", years: "" }, true));
  document.querySelectorAll('input[name="rate-shock"], input[name="rate-direction"]').forEach((radio) => radio.addEventListener("change", updateResults));

  examples.forEach((bond) => addBond(bond, false));

  function registerWebMcp() {
    const context = document.modelContext;
    if (!context || typeof context.registerTool !== "function") return;
    try {
      context.registerTool({
        name: "set_bond_rate_scenario",
        title: "Set bond rate scenario",
        description: "Replace the visible bond list, select a rate rise or fall, and return the updated portfolio estimate.",
        inputSchema: {
          type: "object",
          properties: {
            bonds: {
              type: "array",
              minItems: 1,
              items: {
                type: "object",
                properties: {
                  name: { type: "string" }, amount: { type: "number", exclusiveMinimum: 0 },
                  price: { type: "number", exclusiveMinimum: 0 }, coupon: { type: "number", minimum: 0 },
                  type: { type: "string", enum: ["bullet", "callable", "putable"] },
                  maturityDate: { type: "string" }, years: { type: "number", exclusiveMinimum: 0 }
                },
                required: ["name", "type", "amount", "price", "coupon"],
                anyOf: [{ required: ["years"] }, { required: ["maturityDate"] }], additionalProperties: false
              }
            },
            rateChange: { type: "number", enum: [-0.02, -0.01, -0.005, -0.0025, 0.0025, 0.005, 0.01, 0.02] }
          },
          required: ["bonds", "rateChange"], additionalProperties: false
        },
        annotations: { readOnlyHint: false, untrustedContentHint: false },
        execute(input) {
          const supportedChanges = [-0.02, -0.01, -0.005, -0.0025, 0.0025, 0.005, 0.01, 0.02];
          if (!input || !Array.isArray(input.bonds) || !supportedChanges.includes(input.rateChange)) throw new Error("Provide valid bonds and a supported rate change.");
          const checked = document.querySelector('input[name="rate-shock"][value="' + Math.abs(input.rateChange) + '"]');
          const direction = document.querySelector('input[name="rate-direction"][value="' + (input.rateChange < 0 ? -1 : 1) + '"]');
          if (!checked || !direction) throw new Error("The requested rate change is not available.");
          const validation = BondMath.calculatePortfolio(input.bonds, input.rateChange);
          if (validation.validResults.length !== input.bonds.length) throw new Error("Every bond must have a valid structure, name, positive amount, price, and future maturity or decimal years; coupon cannot be negative.");
          bondList.replaceChildren();
          input.bonds.forEach((bond) => addBond(bond, false));
          checked.checked = true;
          direction.checked = true;
          updateResults();
          const updated = BondMath.calculatePortfolio(input.bonds, input.rateChange);
          return { scenario: input.rateChange < 0 ? "rates_fall" : "rates_rise", validBondCount: updated.validResults.length, currentValue: updated.totals.currentValue, estimatedLoss: updated.totals.loss, estimatedGain: updated.totals.gain, estimatedValueAfterChange: updated.totals.afterValue };
        }
      });
    } catch (error) {
      console.warn("WebMCP tool registration was not available.", error);
    }
  }

  registerWebMcp();
})();

